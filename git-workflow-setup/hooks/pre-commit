#!/bin/sh
# Prevents committing directly to main branch.
# All changes to main must come from merged pull requests.
# Enable with: git config core.hooksPath .githooks
#
# Can be bypassed with: git commit --no-verify

MAIN_BRANCH="main"

current_branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$current_branch" = "$MAIN_BRANCH" ]; then
    echo "❌ Blocked: You cannot commit directly to $MAIN_BRANCH." >&2
    echo "" >&2
    echo "   All changes to $MAIN_BRANCH must come through pull requests:" >&2
    echo "   1. Create a feature branch: git checkout -b feature/your-feature" >&2
    echo "   2. Make your changes and commit" >&2
    echo "   3. Push the feature branch: git push -u origin feature/your-feature" >&2
    echo "   4. Open a PR on GitHub" >&2
    echo "   5. Merge the PR to $MAIN_BRANCH" >&2
    echo "" >&2
    echo "   To bypass this hook (not recommended): git commit --no-verify" >&2
    exit 1
fi

exit 0
